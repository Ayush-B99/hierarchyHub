// the database schema, see docs/adr/0010-database-design.md
//
// prisma only knows about the table, indexes and the manager link. the extra safety rules
// (checks and the loop trigger) live in the migration sql, prisma can't describe those.
// ci compares this file to the real database after migrating, so the two can't drift apart

generator client {
  provider   = "prisma-client-js"
  // the "rust-free" client: queries are built by a small wasm module and sent through
  // node-postgres (pg). no engine binary to download or ship in the docker image, and we
  // control the connection pool and tls settings ourselves (see src/database)
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  // the app user, which can only read and write rows. migrations swap in the migrator user
  url      = env("DATABASE_URL")
}

/// one row per employee. each points at their manager, null means top of the org (adjacency list, adr 0003)
model Employee {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// always upper case, so uniqueness ignores capitals
  employeeNumber String     @unique @map("employee_number") @db.VarChar(20)
  firstName      String     @map("first_name") @db.VarChar(100)
  lastName       String     @map("last_name") @db.VarChar(100)
  /// always lower case, so uniqueness ignores capitals
  email          String     @unique @db.VarChar(255)
  birthDate      DateTime   @map("birth_date") @db.Date
  /// exact decimal, never a float, so money doesn't get rounded
  salary         Decimal    @db.Decimal(12, 2)
  role           String     @db.VarChar(100)
  managerId      String?    @map("manager_id") @db.Uuid
  manager        Employee?  @relation("ReportingLine", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  directReports  Employee[] @relation("ReportingLine")
  /// goes up by one on every change (set by the database), used to catch clashing edits
  version        Int        @default(1)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  /// set by the database on every change
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// the login linked to this person, if they have one
  account        Account?

  // one index per thing we sort, filter or look up by
  @@index([managerId])
  @@index([lastName, firstName])
  @@index([role])
  @@index([salary])
  @@index([birthDate])
  @@map("employees")
}

/// a login. anyone can sign up, but an account does nothing until an admin approves it and
/// links it to an employee (adr 0016)
model Account {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// always lower case
  email        String    @unique @db.VarChar(254)
  name         String    @db.VarChar(100)
  /// argon2id, never the password itself
  passwordHash String    @map("password_hash") @db.VarChar(255)
  /// pending, active or disabled (checked by the database)
  status       String    @default("pending") @db.VarChar(10)
  isAdmin      Boolean   @default(false) @map("is_admin")
  /// who this login is. if the employee is deleted the link is cleared and the account can't sign in
  employeeId   String?   @unique @map("employee_id") @db.Uuid
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// wrong passwords in a row, reset on a good one
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(3)
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(3)
  /// the account that approved this one
  approvedBy   String?   @map("approved_by") @db.Uuid
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions     Session[]

  @@index([status])
  @@map("accounts")
}

/// a signed in browser. the id is a sha-256 hash of the cookie, so a copy of this table
/// can't be used to sign in as anyone
model Session {
  id         String   @id @db.VarChar(64)
  accountId  String   @map("account_id") @db.Uuid
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}

/// a record of something that happened: who did what, to whom, when, and what changed.
/// append only, nothing in it can be changed or deleted (adr 0018). names and positions are
/// copied in at the time, so history still reads right after people are renamed, moved or deleted
model AuditEvent {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  at                DateTime @default(now()) @db.Timestamptz(3)
  /// eg employee.updated or auth.sign_in_failed (checked by the database)
  action            String   @db.VarChar(40)
  /// who did it, if anyone was signed in
  actorAccountId    String?  @map("actor_account_id") @db.Uuid
  actorEmployeeId   String?  @map("actor_employee_id") @db.Uuid
  actorName         String?  @map("actor_name") @db.VarChar(100)
  /// who it was about
  subjectEmployeeId String?  @map("subject_employee_id") @db.Uuid
  subjectName       String?  @map("subject_name") @db.VarChar(201)
  /// the subject and everyone above them when it happened, which decides who can see the event
  scope             String[] @db.Uuid
  /// field: { from, to } for each field that changed
  changes           Json?
  /// anything else worth keeping, eg the email a failed sign in used
  details           Json?
  requestId         String?  @map("request_id") @db.VarChar(100)

  @@index([at(sort: Desc)])
  @@index([subjectEmployeeId])
  @@index([actorAccountId])
  /// deciding who can see an event searches this list
  @@index([scope], type: Gin)
  @@map("audit_events")
}
