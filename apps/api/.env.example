NODE_ENV=development
PORT=3000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# --- security ---
# proxies in front of the api: 0 locally, 2 on aws (cloudfront and the load balancer)
TRUST_PROXY=0
# requests per minute from one ip address
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WRITES_PER_MINUTE=60

# --- database (matches docker-compose.yml, local only, never use these anywhere else) ---
# the api connects as hh_app, which can only read and write rows
DATABASE_URL=postgresql://hh_app:app_local@localhost:5432/hierarchy_hub?schema=public
# disable is fine on your own machine. production must use verify-full with the aws ca file
DATABASE_SSL=disable
# DATABASE_SSL_CA_FILE=/path/to/global-bundle.pem
# connections per api instance (hh_app is capped at 40 in total)
DATABASE_POOL_MAX=10
# strict refuses to start without the database. production on aws uses warn, see adr 0021
DATABASE_STARTUP_CHECK=strict

# migrations run as hh_migrator, which owns the tables
MIGRATOR_DATABASE_URL=postgresql://hh_migrator:migrator_local@localhost:5432/hierarchy_hub?schema=public

# a separate database for integration tests, so they never touch your local data
TEST_DATABASE_URL=postgresql://hh_app:app_local@localhost:5432/hierarchy_hub_test?schema=public
TEST_MIGRATOR_DATABASE_URL=postgresql://hh_migrator:migrator_local@localhost:5432/hierarchy_hub_test?schema=public
