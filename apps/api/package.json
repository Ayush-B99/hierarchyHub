{
  "name": "@hierarchy-hub/api",
  "version": "0.0.0",
  "private": true,
  "description": "Hierarchy Hub REST API (NestJS)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/jest-e2e.config.js",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@hierarchy-hub/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hierarchy-hub/eslint-config": "workspace:*",
    "@hierarchy-hub/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0"
  }
}
