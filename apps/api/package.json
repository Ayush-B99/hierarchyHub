{
  "name": "@hierarchy-hub/api",
  "version": "0.0.0",
  "private": true,
  "description": "Hierarchy Hub REST API (NestJS)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/jest-e2e.config.js",
    "clean": "rm -rf dist coverage .turbo",
    "test:integration": "jest --config test/jest-integration.config.js",
    "db:migrate": "node scripts/prisma-as.mjs migrator migrate deploy",
    "db:migrate:test": "node scripts/prisma-as.mjs test-migrator migrate deploy",
    "db:new-migration": "node scripts/prisma-as.mjs migrator migrate dev --create-only",
    "db:check": "node scripts/prisma-as.mjs migrator migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hierarchy-hub/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hierarchy-hub/eslint-config": "workspace:*",
    "@hierarchy-hub/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5",
    "@types/jest": "^29.5.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "eslint": "catalog:",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
