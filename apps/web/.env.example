# Base URL of the API. Leave unset locally to use /api (the Vite dev proxy or the mock API).
# VITE_API_URL=https://your-api.example.com/api

# Development uses the real API (task api). Set to true to use the mock API instead,
# eg to work on screens without the backend running. Never used in production builds.
# VITE_API_MOCKING=true
