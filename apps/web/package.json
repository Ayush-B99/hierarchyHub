{
  "name": "@hierarchy-hub/web",
  "version": "0.0.0",
  "private": true,
  "description": "Hierarchy Hub single-page app (React + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@hierarchy-hub/shared": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@hierarchy-hub/eslint-config": "workspace:*",
    "@hierarchy-hub/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "eslint": "catalog:",
    "jsdom": "^26.0.0",
    "msw": "^2.15.0",
    "typescript": "catalog:",
    "vite": "^7.0.0",
    "vitest": "catalog:"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
