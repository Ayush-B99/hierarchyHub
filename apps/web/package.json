{
  "name": "@hierarchy-hub/web",
  "version": "0.0.0",
  "private": true,
  "description": "Hierarchy Hub single-page app (React + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@hierarchy-hub/shared": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@hierarchy-hub/eslint-config": "workspace:*",
    "@hierarchy-hub/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "vite": "^7.0.0",
    "vitest": "catalog:"
  }
}
