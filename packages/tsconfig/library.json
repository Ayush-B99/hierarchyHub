{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Library (bundled with tsup)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  }
}
