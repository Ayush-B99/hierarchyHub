{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS (Node, CommonJS output)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "sourceMap": true,
    "incremental": true,
    "removeComments": true
  }
}
